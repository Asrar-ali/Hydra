# Copy to .env (untracked) and fill in. NEVER commit real secrets.

# --- adversary (local, offline) ---
HYDRA_OLLAMA_HOST=http://127.0.0.1:11434
HYDRA_ADVERSARY_MODEL=mistral:7b   # reliable, fast; jimscard/whiterabbit-neo is on-theme but can't
                                    # reliably finish Track 1 (verified — see README, common/config.py)
HYDRA_ADV_ATTEMPTS=3                              # LLM retries per iteration before falling back

# --- optional cloud backup (OpenAI-compatible gateway) ---
HYDRA_RDSEC_BASE=
HYDRA_RDSEC_KEY=                         # from the environment only, never committed

# --- behavior thresholds (must match the Falco rule) ---
HYDRA_FILES_K=10
HYDRA_ENTROPY_H=7.0
HYDRA_ITERATION_CAP=12

# --- dev ---
HYDRA_LOG_LEVEL=INFO
# HYDRA_FAKE=1                           # run the loop without a container
